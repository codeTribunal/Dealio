DATABASE_URL=
# REQUIRED. Strong random value, e.g. `openssl rand -hex 32`. The server REFUSES
# to boot if this is missing or a known placeholder — there is NO dev fallback.
JWT_SECRET=
JWT_EXPIRES_IN=30d
FCM_SERVER_KEY=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=
PORT=3000
NODE_ENV=development
BOT_MANAGER_SECRET=
BOT_TOKEN_ENCRYPTION_KEY=
BACKEND_URL=http://localhost:3000
BOT_SERVICE_URL=http://localhost:3003
OWNER_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002
# REQUIRED (admin-panel token signing). Strong random, DISTINCT from JWT_SECRET.
# Server refuses to boot if missing/placeholder — no dev fallback.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=8h
# Central platform bot (owner auth via Telegram). Create it via BotFather.
# PLATFORM_BOT_USERNAME is the @handle WITHOUT the @ (used to build deep links).
PLATFORM_BOT_TOKEN=
PLATFORM_BOT_USERNAME=
# REQUIRED (keyed HMAC for OTP codes). No longer falls back to JWT_SECRET — set
# its own strong random value. Server refuses to boot if missing/placeholder.
# Local dev/tests: any 16+ char non-placeholder string works.
OTP_HASH_SECRET=