generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id           String    @id @default(cuid())
  name         String
  description  String?
  photoUrl     String?
  // Physical location shown to customers: pickup point (PRODUCTS) and
  // appointment location (SERVICES). One field, both uses. Optional.
  address      String?
  // Single business mode (was Mode[] — migrated to a scalar in Step 2).
  // PRODUCTS remains in the enum but is no longer selectable (dormant).
  mode         Mode      @default(SERVICES)
  language     Language  @default(UZBEK)
  botUsername           String?   @unique
  calendarToken         String?   @unique
  // Working hours: JSON object keyed "0".."6" (0=Sunday … 6=Saturday, in
  // Asia/Tashkent local time), each value either { start: "HH:MM", end: "HH:MM" }
  // or null = closed that day. Absent object entirely = never configured.
  workingHours          Json?
  // Gap (minutes) enforced after each appointment before the next can start.
  bufferMinutes         Int       @default(0)
  // Payment — P2P card transfer. Owner edits via PATCH /business/payment.
  // Display/edit visibility is gated GLOBALLY by
  // PlatformSettings.cardPaymentsEnabled; the flag never clears stored data.
  cardNumber            String?
  cardHolderName        String?
  reminderSettings      Json?
  ownerTelegramChatId   String?
  fcmToken              String?
  ownerId               String    @unique
  owner        User      @relation(fields: [ownerId], references: [id])

  // Subscription
  plan            Plan      @default(FREE)
  planExpiresAt   DateTime?
  suspendedAt     DateTime?
  suspendedReason String?

  // Self-serve account deletion (owner-initiated, 30-day recoverable window).
  // Requesting deletion ALSO sets suspendedAt (reusing the single suspension
  // enforcement path), so PENDING_DELETION is blocked everywhere a suspended
  // business is. The purge job keys off deletionState + deletionScheduledAt.
  deletionState        DeletionState @default(ACTIVE)
  deletionRequestedAt  DateTime?
  deletionScheduledAt  DateTime?

  // Bot token — stored encrypted, never plain text in production
  botTokenEncrypted String?
  botTokenIv        String?
  botTokenTag       String?

  customers         Customer[]
  usageLogs         UsageLog[]
  products          Product[]
  orders            Order[]
  services          Service[]
  staff             Staff[]
  appointments      Appointment[]
  projects          Project[]
  tags              CustomerTag[]
  reminders         Reminder[]
  customFields      BusinessCustomField[]
  stages            CustomerStage[]
  checkoutQuestions CheckoutQuestion[]
  deviceTokens      DeviceToken[]
  sentReminders     SentReminder[]
  blockedSlots      BlockedSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletionState, deletionScheduledAt])
  // GIN trigram index for admin ILIKE %…% search — created (with the pg_trgm
  // extension) by the raw 20260608010000_search_trgm_indexes migration;
  // declared here so `prisma migrate diff` recognizes it.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_business_name_trgm")
}

model SentReminder {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])

  // What this reminder was about
  entityType   String // "APPOINTMENT" | "ORDER" | "MILESTONE" | "PROJECT"
  entityId     String // the appointment/order/milestone/project id
  reminderKind String // "FIRST" | "SECOND" — for appointments with two reminders

  sentAt       DateTime @default(now())

  @@unique([businessId, entityType, entityId, reminderKind])
  @@index([businessId])
  @@index([entityId])
}

model DeviceToken {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  token      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, token])
  @@index([businessId])
}

model User {
  id             String          @id @default(cuid())
  phone          String          @unique
  // Telegram binding for owner auth. telegramChatId is the platform-bot chat
  // we send LOGIN codes to; telegramVerifiedAt is set when the user first
  // completes enrollment (shares contact + enters the ENROLL code).
  telegramChatId     String?
  telegramVerifiedAt DateTime?
  // Optional owner email + newsletter/marketing consent (SEPARATE from the GDPR
  // enrollment consents in ConsentRecord). email is stored trimmed+lowercased or
  // null. newsletterConsentAt is set ONLY when consent is true (provable opt-in
  // time). The emailPrompt* fields drive the capped re-push of the analytics
  // email-capture card (one retry after 30 days, then never).
  email                   String?
  newsletterConsent       Boolean   @default(false)
  newsletterConsentAt     DateTime?
  emailPromptDismissedAt  DateTime?
  emailPromptDismissCount Int       @default(0)
  business       Business?
  consentRecords ConsentRecord[]
  createdAt      DateTime        @default(now())

  // Trigram index for admin owner-phone substring search (the @unique b-tree
  // cannot serve %…%). Created by 20260608010000_search_trgm_indexes.
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_user_phone_trgm")
}

model ConsentRecord {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  generalConsent     Boolean  @default(false)
  crossBorderConsent Boolean  @default(false)
  policyVersion      String
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime @default(now())

  @@index([userId])
}

model Customer {
  id                 String    @id @default(cuid())
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id])
  telegramUserId     String?
  telegramUsername   String?
  name               String
  phone              String?
  birthday           DateTime?
  notes              String?
  customFields       Json?
  currentStageId     String?
  currentStage       CustomerStage? @relation(fields: [currentStageId], references: [id])
  languagePreference Language?
  // First-contact data-subject consent (ZRU-547): captured by the bot BEFORE any
  // personal data is stored. "consented" = consentedAt set AND consentVersion ===
  // the current CONSENT_VERSION; a version bump forces re-consent. Covers both
  // ordinary processing and cross-border transfer in one acceptance.
  consentedAt        DateTime?
  consentVersion     String?
  deletedAt          DateTime?
  // Set by the irreversible GDPR-style anonymize path (Phase C). When non-null
  // the row's personal fields have been scrubbed and the customer is "erased"
  // while its de-identified transactional records are retained.
  anonymizedAt       DateTime?

  orders       Order[]
  appointments Appointment[]
  projects     Project[]
  tags         CustomerTag[]
  reminders    Reminder[]
  fieldValues  CustomerFieldValue[]

  createdAt         DateTime @default(now())
  lastInteractionAt DateTime @default(now())

  @@unique([businessId, telegramUserId])
  // GIN trigram indexes for admin ILIKE %…% search — created (with pg_trgm)
  // by the raw 20260608010000_search_trgm_indexes migration.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_customer_name_trgm")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_customer_phone_trgm")
  @@index([telegramUsername(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_customer_telegram_trgm")
}

model Product {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  name        String
  description String?
  price       Int
  photos      String[]
  stockQty    Int?
  unlimited   Boolean   @default(false)
  variants    Json?
  prepTime    String?
  active      Boolean   @default(true)
  deletedAt   DateTime?

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String         @id @default(cuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id])
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  orderNumber     Int
  items           OrderItem[]
  total           Int
  deliveryMethod  DeliveryMethod
  deliveryAddress String?
  deliveryDate    DateTime?
  notes           String?
  internalNotes   String?
  customAnswers   Json?
  idempotencyKey  String?
  paymentStatus   PaymentStatus  @default(PENDING)
  // Telegram file_id of the customer's payment-proof screenshot. Set when the
  // customer sends the screenshot after "I have paid". Proxied on demand via
  // getFile using THIS business's bot token; never returned raw to clients (the
  // API exposes only the boolean hasPaymentProof).
  paymentProofFileId String?
  paymentProofAt     DateTime?
  // Optional public URL of the proof once archived to R2 by a FUTURE background
  // job (reads paymentProofFileId → downloads → uploads → sets this). Not
  // written in the live checkout path today.
  paymentProofUrl String?
  orderStatus     OrderStatus    @default(NEW)
  timeline        Json[]
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, orderNumber])
  @@unique([businessId, idempotencyKey])
  @@index([customerId])
  @@index([businessId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
  variant   Json?
}

model Service {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  name            String
  durationMinutes Int
  price           Int
  active          Boolean   @default(true)
  deletedAt       DateTime?

  staffServices StaffService[]
  appointments  Appointment[]

  createdAt DateTime @default(now())
}

model Staff {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id])
  name           String
  telegramHandle String?
  // Same shape as Business.workingHours: JSON keyed "0".."6" (0=Sunday …
  // 6=Saturday, Asia/Tashkent local), value { start: "HH:MM", end: "HH:MM" }
  // or null = closed. NOTE: the availability engine drives the slot window
  // from Business.workingHours (business-wide); this column is retained but
  // does not currently drive per-staff windows.
  workingHours   Json?
  daysOff        DateTime[]
  deletedAt      DateTime?

  staffServices StaffService[]
  appointments  Appointment[]
  blockedSlots  BlockedSlot[]

  createdAt DateTime @default(now())
}

model StaffService {
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id])
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([staffId, serviceId])
}

model BlockedSlot {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  staffId    String? // null = whole-business block
  staff      Staff?   @relation(fields: [staffId], references: [id])
  startTime  DateTime
  endTime    DateTime
  reason     String?
  createdAt  DateTime @default(now())

  @@index([businessId, startTime])
}

model Appointment {
  id            String             @id @default(cuid())
  businessId    String
  business      Business           @relation(fields: [businessId], references: [id])
  customerId    String
  customer      Customer           @relation(fields: [customerId], references: [id])
  serviceId     String
  service       Service            @relation(fields: [serviceId], references: [id])
  staffId       String?
  staff         Staff?             @relation(fields: [staffId], references: [id])
  startTime     DateTime
  endTime       DateTime
  price         Int
  notes         String?
  paymentType   ServicePaymentType @default(AT_APPOINTMENT)
  paymentStatus PaymentStatus      @default(PENDING)
  status        AppointmentStatus  @default(REQUESTED)
  reminderSent  Boolean            @default(false)
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([businessId])
  @@index([startTime])
}

model Project {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id])
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  name         String
  description  String?
  paymentTerms String?
  totalPrice   Int
  startDate    DateTime?
  deadline     DateTime?
  status       ProjectStatus @default(PROPOSAL_SENT)
  deletedAt    DateTime?

  milestones Milestone[]
  invoices   Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([customerId])
}

model Milestone {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id])
  name      String
  dueDate   DateTime?
  amount    Int
  status    MilestoneStatus @default(PENDING)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Invoice {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id])
  invoiceNumber String        @unique
  lineItems     Json[]
  total         Int
  dueDate       DateTime?
  status        InvoiceStatus @default(UNPAID)

  createdAt DateTime @default(now())
}

model CustomerTag {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  label      String
  color      String   @default("#6366F1")
  createdAt  DateTime @default(now())
}

model Reminder {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  note       String
  dueDate    DateTime
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Short-lived one-time codes for owner auth via the platform bot.
// Only a HASH of the code is stored (codeHash) — never the plaintext.
// purpose: "ENROLL" (first-time binding) | "LOGIN" (returning login).
model OtpCode {
  id         String    @id @default(cuid())
  userId     String? // null during enrollment before the User exists, else the User
  phone      String
  chatId     String? // where the code was sent (returning login) / bound (enroll)
  codeHash   String // HASH of the code, never plaintext
  purpose    String // "ENROLL" | "LOGIN"
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
}

// One-time deep-link token for first-time enrollment. The token rides in the
// platform-bot deep link (t.me/<bot>?start=<token>). chatId is filled when the
// user opens the bot; phone is filled once they share their contact.
model LinkToken {
  id         String    @id @default(cuid())
  token      String    @unique // random hex, in the deep link
  phone      String? // filled once contact is shared
  chatId     String? // filled when user starts the bot
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
}

model BusinessCustomField {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  name       String
  fieldType  FieldType @default(TEXT)
  order      Int       @default(0)
  deletedAt  DateTime?

  values CustomerFieldValue[]

  createdAt DateTime @default(now())
}

model CustomerFieldValue {
  id       String              @id @default(cuid())
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id])
  fieldId  String
  field    BusinessCustomField @relation(fields: [fieldId], references: [id])
  value    String

  @@unique([customerId, fieldId])
}

model CustomerStage {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  name       String
  color      String    @default("#6366F1")
  order      Int       @default(0)
  deletedAt  DateTime?

  customers Customer[]

  createdAt DateTime @default(now())
}

model CheckoutQuestion {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  question   String
  required   Boolean   @default(false)
  order      Int       @default(0)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         AdminRole  @default(SUPPORT)
  lastLoginAt  DateTime?
  // Per-account login lockout (brute-force defense). failedLoginCount is the
  // consecutive-failure counter (reset on success); lockedUntil, when in the
  // future, denies login regardless of password.
  failedLoginCount Int    @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs AuditLog[]
}

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([targetType, targetId])
}

model UsageLog {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  month        String
  orders       Int      @default(0)
  appointments Int      @default(0)
  customers    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, month])
  @@index([businessId])
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
}

/// Owner account-deletion lifecycle. ACTIVE = normal. PENDING_DELETION = the
/// owner requested deletion; the business is suspended immediately and hard-
/// purged after the 30-day recovery window (deletionScheduledAt) unless the
/// owner reactivates by logging back in.
enum DeletionState {
  ACTIVE
  PENDING_DELETION
}

/// The two in-force legal documents. The document TEXT lives in the codebase
/// (web/lib/legalConfig.ts) and deploys separately; this enum + LegalDocument
/// only track which VERSION is currently in force.
enum LegalDocType {
  PRIVACY
  OFFER
}

/// One row per legal document (PRIVACY, OFFER). Stores ONLY the in-force version
/// + when/by whom it was published — never the document text. Publishing a new
/// PRIVACY version is what forces re-consent (customers via the bot consent gate,
/// owners via the login CONSENT_REQUIRED gate); both read this row's version.
/// publishedByAdminId is a plain id (the authoritative "who" is the AuditLog).
model LegalDocument {
  id                 String       @id @default(cuid())
  docType            LegalDocType @unique
  version            String
  publishedAt        DateTime     @default(now())
  publishedByAdminId String?
  updatedAt          DateTime     @updatedAt
}

/// Global, platform-wide settings — a single row (id = "singleton").
/// NOT per-business: superadmin-controlled toggles that apply to the whole
/// platform. Keep this separate from Business precisely because it is global.
model PlatformSettings {
  id String @id @default("singleton")

  /// When false, the card-payment SETUP (onboarding/Settings) and DISPLAY
  /// (bot checkout) are hidden platform-wide. Default true = shown. This is a
  /// visibility flag only — no payment fields/data are removed when it is off.
  cardPaymentsEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

enum Mode {
  PRODUCTS
  SERVICES
  FREELANCE
}

enum Language {
  UZBEK
  RUSSIAN
  ENGLISH
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum PaymentStatus {
  PENDING
  PAYMENT_RECEIVED
  CONFIRMED
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ServicePaymentType {
  AT_APPOINTMENT
  IN_ADVANCE
}

enum ProjectStatus {
  PROPOSAL_SENT
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  SUBMITTED_FOR_REVIEW
  APPROVED
  PAYMENT_RECEIVED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  YESNO
}

enum Plan {
  FREE
  PRO
  BUSINESS
}
